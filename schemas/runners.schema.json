{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Radar declared runner profiles v1",
 "type": "object", "additionalProperties": false, "required": ["version", "profiles"],
 "properties": {
  "version": {"const": 1},
  "max_cache_bytes": {"type":"integer","minimum":1,"maximum":10737418240},
  "profiles": {"type":"array","maxItems":128,"items":{
   "type":"object","additionalProperties":false,"required":["root","prefix"],
   "properties": {
    "root":{"type":"string","minLength":1},
    "prefix":{"$ref":"#/$defs/argv"},
    "setup":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/argv"}},
    "exclude":{"type":"array","items":{"type":"string"}},
    "lockfiles":{"type":"array","maxItems":32,"items":{"type":"string","minLength":1}},
    "artifacts":{"type":"array","maxItems":8,"items":{"type":"string","minLength":1}},
    "coverage":{"type":"object","additionalProperties":false,"required":["format","report"],"properties":{"format":{"enum":["python","go","jacoco","llvm","c8"]},"report":{"type":"string","minLength":1}}}
   }
  }}
 },
 "$defs":{"argv":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"string","maxLength":8192}}}
}
