{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.engine/schemas/evidence.schema.json",
  "title": "Radar immutable checkpoint test evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "repository",
    "revision",
    "plan_digest",
    "command",
    "criteria",
    "tests_run",
    "exit_code",
    "status",
    "started_at",
    "finished_at",
    "output_digest",
    "integrity_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^evidence:[a-f0-9]{64}$"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "description": "Location-independent identity git:<root commit SHAs>, or the checkout path for repositories without history (and Radar 0.1 records)."
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests_run": {
      "type": "integer",
      "minimum": 0
    },
    "exit_code": {
      "type": "integer"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "timeout",
        "unknown",
        "error"
      ],
      "description": "error: the command (or a setup step) failed before any recognized test result."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "output_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "integrity_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tests_failed": {
      "type": "integer",
      "minimum": 0
    },
    "tests_skipped": {
      "type": "integer",
      "minimum": 0
    },
    "harness": {
      "enum": [
        "go-test-json",
        "unittest",
        "pytest",
        "jest",
        "vitest",
        "node-test",
        "cargo-test",
        "junit"
      ]
    },
    "env": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phase": {
      "enum": [
        "setup",
        "test"
      ]
    },
    "cwd": {
      "type": "string"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "source_before",
        "source_after",
        "source_unchanged",
        "config_digest",
        "review_digest"
      ],
      "properties": {
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "base",
            "revision",
            "tree",
            "inputs"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "base": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "tree": {
              "type": "string"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "source_before": {
          "type": "string"
        },
        "source_after": {
          "type": "string"
        },
        "source_unchanged": {
          "type": "boolean"
        },
        "config_digest": {
          "type": "string"
        },
        "review_digest": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          },
          "tests_run": {
            "minimum": 1
          },
          "tests_failed": {
            "const": 0
          }
        }
      }
    }
  ]
}
