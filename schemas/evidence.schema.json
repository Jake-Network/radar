{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.engine/schemas/evidence.schema.json",
  "title": "Radar immutable checkpoint test evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "repository", "revision", "plan_digest", "command", "criteria", "tests_run", "exit_code", "status", "started_at", "finished_at", "output_digest", "integrity_digest"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^evidence:[a-f0-9]{64}$"},
    "repository": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
    "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "tests_run": {"type": "integer", "minimum": 0},
    "exit_code": {"type": "integer"},
    "status": {"enum": ["passed", "failed", "timeout", "unknown"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "output_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "integrity_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"exit_code": {"const": 0}, "tests_run": {"minimum": 1}}}}]
}
